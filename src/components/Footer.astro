<!-- Site Footer — Redesign -->
<footer class="site-footer" id="contact">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__cta">
        <h2 class="site-footer__heading">Want to talk?</h2>
        <p class="site-footer__text">I'm interested in product design roles, collaborations, and good problems worth digging into.</p>
        <div class="site-footer__links">
          <a
            href="mailto:lidia.ochoa@uxbylidiaochoa.com?subject=Contact%20regarding%20portfolio"
            class="site-footer__link"
            style="background: var(--color-orange);"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Email
          </a>
          <a
            href="https://www.linkedin.com/in/lidia-ochoa/"
            class="site-footer__link"
            style="background: var(--color-teal);"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Connect with Lidia on LinkedIn (opens in new tab)"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            LinkedIn
          </a>
          <a
            href="/resume/Lidia_Ochoa_Product_Designer_Resume.pdf"
            class="site-footer__link"
            style="background: var(--color-green);"
            aria-label="Resume (downloads PDF)"
            download
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            Resume
          </a>
        </div>
      </div>
      <form class="contact-form" action="https://api.web3forms.com/submit" method="POST" aria-labelledby="contact-form-heading">
        <input type="hidden" name="access_key" value="b71c27b3-6dc4-4355-95d6-f917e93ca374" />
        <input type="hidden" name="subject" value="New contact from UXbyLidiaOchoa.com" />
        <input type="checkbox" name="botcheck" style="display:none" aria-hidden="true" tabindex="-1" />
        <h3 id="contact-form-heading" class="sr-only">Contact form</h3>
        <div class="contact-form__field">
          <label for="contact-name" class="contact-form__label">Name</label>
          <input type="text" id="contact-name" name="name" required autocomplete="name" class="contact-form__input" />
        </div>
        <div class="contact-form__field">
          <label for="contact-email" class="contact-form__label">Email</label>
          <input type="email" id="contact-email" name="email" required autocomplete="email" class="contact-form__input" />
        </div>
        <div class="contact-form__field">
          <label for="contact-message" class="contact-form__label">Message</label>
          <textarea id="contact-message" name="message" rows="4" required class="contact-form__input contact-form__textarea"></textarea>
        </div>
        <button type="submit" class="contact-form__submit">
          Send message
          <span aria-hidden="true">&rarr;</span>
        </button>
        <p class="contact-form__success" aria-live="polite" hidden>Got it. Thanks for reaching out.</p>
        <p class="contact-form__error" aria-live="assertive" hidden>Something went wrong. You can email me directly at <a href="mailto:lidia.ochoa@uxbylidiaochoa.com">lidia.ochoa@uxbylidiaochoa.com</a>.</p>
        <noscript><p class="contact-form__noscript">This form requires JavaScript. You can reach me directly at <a href="mailto:lidia.ochoa@uxbylidiaochoa.com">lidia.ochoa@uxbylidiaochoa.com</a>.</p></noscript>
      </form>
    </div>
    <div class="site-footer__bottom">
      <p>&copy; 2026 Lidia Ochoa</p>
      <p>Seattle, WA &middot; Designed & built by Lidia Ochoa</p>
    </div>
  </div>
</footer>

<script>
  const form = document.querySelector('.contact-form') as HTMLFormElement | null;
  if (form) {
    const successMsg = form.querySelector('.contact-form__success') as HTMLElement;
    const errorMsg = form.querySelector('.contact-form__error') as HTMLElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      successMsg.hidden = true;
      errorMsg.hidden = true;
      const btn = form.querySelector('.contact-form__submit') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Sending\u2026';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        if (res.ok) {
          form.reset();
          successMsg.hidden = false;
        } else {
          errorMsg.hidden = false;
        }
      } catch {
        errorMsg.hidden = false;
      }
      btn.disabled = false;
      btn.innerHTML = 'Send message <span aria-hidden="true">&rarr;</span>';
    });
  }
</script>
