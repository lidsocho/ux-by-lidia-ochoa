---
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  projectColor?: string;
  ogImage?: string;
  canonicalPath?: string;
  structuredData?: object;
}

const {
  title,
  description = 'Product designer in Seattle specializing in accessibility, systems thinking, and designing through working software.',
  projectColor,
  ogImage,
  canonicalPath,
  structuredData,
} = Astro.props;

const siteUrl = 'https://uxbylidiaochoa.com';
const currentPath = canonicalPath || Astro.url.pathname;
const canonicalUrl = `${siteUrl}${currentPath}`;
const resolvedOgImage = ogImage
  ? `${siteUrl}${ogImage}`
  : `${siteUrl}/images/lidia-profile.png`;

// Compute a static color-mix fallback (10% project color on #fafafa) at build time
function mixFallback(hex: string): string {
  const r = parseInt(hex.slice(1, 3), 16);
  const g = parseInt(hex.slice(3, 5), 16);
  const b = parseInt(hex.slice(5, 7), 16);
  const bg = 0xfa; // #fafafa
  const mix = (c: number) => Math.round(c * 0.1 + bg * 0.9).toString(16).padStart(2, '0');
  return `#${mix(r)}${mix(g)}${mix(b)}`;
}
const cardBgFallback = projectColor ? mixFallback(projectColor) : undefined;

// Mute a hex color for dark mode (reduce brightness by ~20%)
function mutedColor(hex: string): string {
  const r = parseInt(hex.slice(1, 3), 16);
  const g = parseInt(hex.slice(3, 5), 16);
  const b = parseInt(hex.slice(5, 7), 16);
  const mute = (c: number) => Math.round(c * 0.8).toString(16).padStart(2, '0');
  return `#${mute(r)}${mute(g)}${mute(b)}`;
}
const projectColorDark = projectColor ? mutedColor(projectColor) : undefined;
const cardBgFallbackDark = projectColorDark ? mixFallback(projectColorDark) : undefined;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={resolvedOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Lidia Ochoa" />

  <!-- Twitter/X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={resolvedOgImage} />

  {projectColorDark && (
    <style set:html={`
      @media (prefers-color-scheme: dark) {
        #main-content {
          --color-project: ${projectColorDark} !important;
          --color-card-tint: ${projectColorDark} !important;
          --color-card-bg: ${cardBgFallbackDark} !important;
          --color-card-bg: color-mix(in srgb, ${projectColorDark} 10%, var(--color-bg)) !important;
        }
      }
    `} />
  )}

  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}

  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700;800&family=Commissioner:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <SkipLink />
  <Header />
  <main id="main-content" style={projectColor ? `--color-project: ${projectColor}; --color-card-tint: ${projectColor}; --color-card-bg: ${cardBgFallback}; --color-card-bg: color-mix(in srgb, ${projectColor} 10%, var(--color-bg));` : undefined}>
    <slot />
  </main>
  <Footer />

  <!-- Lightbox -->
  <div class="lightbox-overlay" id="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged image">
    <button class="lightbox-close" aria-label="Close lightbox">&times;</button>
    <div class="lightbox-content">
      <img class="lightbox-content__img" src="" alt="" />
      <p class="lightbox-caption"></p>
    </div>
  </div>

  <script src="/scripts/reveal.js" is:inline></script>
  <script is:inline>
  (function () {
    var overlay = document.getElementById('lightbox');
    if (!overlay) return;
    var lbImg = overlay.querySelector('.lightbox-content__img');
    var lbCaption = overlay.querySelector('.lightbox-caption');
    var closeBtn = overlay.querySelector('.lightbox-close');
    var lastFocus = null;

    function open(src, alt) {
      lastFocus = document.activeElement;
      lbImg.src = src;
      lbImg.alt = alt || '';
      lbCaption.textContent = alt || '';
      lbCaption.style.display = alt ? '' : 'none';
      overlay.classList.add('lightbox-overlay--open');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      overlay.classList.remove('lightbox-overlay--open');
      document.body.style.overflow = '';
      lbImg.src = '';
      if (lastFocus) lastFocus.focus();
    }

    // Attach to all case-section and two-col images (not device frames, icons, or decorative)
    document.querySelectorAll('.case-section img, .two-col img, .hp-card__visual img').forEach(function (img) {
      if (img.closest('.png-device-frame') || img.getAttribute('aria-hidden') === 'true') return;
      img.style.cursor = 'zoom-in';
      img.setAttribute('tabindex', '0');
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', 'Enlarge: ' + (img.alt || 'image'));
      img.addEventListener('click', function () { open(img.src, img.alt); });
      img.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(img.src, img.alt); }
      });
    });

    // Close handlers
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.classList.contains('lightbox-overlay--open')) close();
    });

    // Trap focus inside lightbox
    overlay.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab') return;
      var focusable = overlay.querySelectorAll('button, [tabindex="0"]');
      var first = focusable[0], last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  })();
  </script>
</body>
</html>
