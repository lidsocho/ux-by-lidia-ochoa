---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyHero from '../components/CaseStudyHero.astro';
import SideNav from '../components/SideNav.astro';
import KeepExploring from '../components/KeepExploring.astro';

const sections = [
  { id: 'collaboration', label: 'Collaboration and task delegation' },
  { id: 'securing-funding', label: 'Securing the funding' },
  { id: 'designing-campaign', label: 'Designing the campaign' },
  { id: 'catalogue', label: 'Making the catalogue work in the gallery' },
  { id: 'programming-month', label: 'Programming the month' },
  { id: 'designing-participation', label: 'Designing for participation' },
  { id: 'keeping-coherent', label: 'Keeping the whole thing coherent' },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Work", "item": "https://uxbylidiaochoa.com/#featured-work" },
    { "@type": "ListItem", "position": 2, "name": "Our Light Unbound", "item": "https://uxbylidiaochoa.com/our-light-unbound/" }
  ]
};
---
<BaseLayout
  title="Our Light Unbound | Exhibition Design | Lidia Ochoa"
  description="Month-long community art exhibition at Slip Gallery. Co-curated with Yaz, with campaign design, digital catalogue, workshop programming, and 1,000+ opening-night visitors."
  projectColor="#bea7be"
  canonicalPath="/our-light-unbound/"
  structuredData={structuredData}
>
  <CaseStudyHero
    eyebrow="Our Light Unbound"
    headline="Designing a month-long exhibition across gallery, campaign, programming, and digital experience"
    deck="Co-curated with Yaz. I led the promotional campaign, workshop scheduling, digital catalogue, venue coordination, and much of the visitor experience."
    heroImage="/images/home/olu-phone-thumb.png"
    heroAlt="Our Light Unbound digital catalogue shown on an iPhone, displaying the exhibition title, dates, and mission statement on a twilight gradient"
    heroNoBorder
    role="Co-curator, campaign & experience design"
    timeline="Jun 2024 – Jan 2026"
    status="Completed public exhibition"
    focus="Experience design · Campaign · Accessibility"
    metrics={[
      { value: '$11,500', label: 'in grant funding from 4Culture' },
      { value: '1,000+', label: 'opening-night visitors' },
      { value: '36', label: 'campaign posts' },
    ]}
    accentColor="#bea7be"
  />

  <div class="case-body">
    <SideNav sections={sections} />
    <div class="case-sections">

      <!-- 1. Collaboration and task delegation -->
      <section class="case-section section" id="collaboration" aria-labelledby="collaboration-heading">
        <div class="container">
          <h2 id="collaboration-heading" class="case-section__heading reveal">Collaboration and task delegation</h2>
          <p class="reveal">Yaz and I shared a vision for the show, divided into distinct roles.</p>
          <p class="reveal">We co-curated Our Light Unbound together over roughly eighteen months. Yaz led merchandise and much of the core identity. I led the promotional campaign, workshop scheduling, digital catalogue, venue coordination, and much of the visitor experience.</p>
          <p class="reveal">Some responsibilities overlapped, but making ownership explicit helped a project with many moving parts stay manageable from early planning through the public exhibition.</p>
        </div>
      </section>

      <!-- 2. Securing the funding -->
      <section class="case-section section" id="securing-funding" aria-labelledby="securing-funding-heading">
        <div class="container">
          <h2 id="securing-funding-heading" class="case-section__heading reveal">Securing the funding</h2>
          <p class="reveal">We secured $11,500 from 4Culture to support the exhibition.</p>
          <p class="reveal">I identified eligible grant opportunities, wrote applications with Yaz, built the budgets, managed the funding, and reported the outcomes.</p>
          <p class="reveal">The funding supported production, programming, and artist participation rather than functioning as a decorative credential around the project.</p>
        </div>
      </section>

      <!-- 3. Designing the campaign -->
      <section class="case-section section" id="designing-campaign" aria-labelledby="designing-campaign-heading">
        <div class="container">
          <h2 id="designing-campaign-heading" class="case-section__heading reveal">Designing the campaign</h2>
          <p class="reveal">The public campaign had to introduce the exhibition, give individual artists room to be seen, and build enough momentum to bring people into the gallery.</p>
          <p class="reveal">The campaign included 36 posts. By opening night, the account had 148 followers. One reel reached roughly 2.5K views, and individual artist features reached as many as 1,698 views.</p>
          <p class="reveal">The campaign was one part of a larger visitor journey that continued into the gallery rather than ending at the event announcement.</p>

          <div class="two-col reveal">
            <img src="/images/our-light-unbound/instagram-grid.png" alt="Instagram grid showing artist shoutout posts, the online exhibition catalogue announcement with QR code, and collaboration posts" width="1170" height="2532" loading="lazy" />
            <img src="/images/our-light-unbound/campaign-poster.png" alt="Our Light Unbound exhibition poster with the wordmark, featured artwork, dates, free admission, and a QR code on a deep twilight gradient background" width="816" height="1056" loading="lazy" />
          </div>

          <img src="/images/our-light-unbound/campaign-exhibit-ad.png" alt="Landscape Our Light Unbound exhibit ad with the mission statement, exhibition dates, venue, QR code, and 4Culture logo on a glowing gradient" width="1200" height="1048" class="reveal" loading="lazy" />
        </div>
      </section>

      <!-- 4. Making the catalogue work in the gallery -->
      <section class="case-section section" id="catalogue" aria-labelledby="catalogue-heading">
        <div class="container">
          <h2 id="catalogue-heading" class="case-section__heading reveal">Making the catalogue work in the gallery</h2>
          <blockquote class="reveal">
            <p>I wanted artists to be able to share their message, but I did not want artwork descriptions to become more wall text.</p>
          </blockquote>
          <p class="reveal">The digital catalogue used QR access so visitors could choose how much context they wanted while standing with the work.</p>
          <p class="reveal">It was designed mobile-first and supported artist and artwork search, expandable sections, purchasing information, and device-level text resizing without blocking the physical artwork with more printed explanation.</p>
          <p class="reveal">Accessibility was part of the implementation. The catalogue used strong contrast, visible focus states, semantic accordion behavior, aria-expanded, aria-live, and keyboard navigation.</p>

          <div class="two-col reveal">
            <img src="/images/our-light-unbound/catalogue-expanded.png" alt="Digital catalogue showing an expanded artist accordion with biography, artwork photograph, details, and description" width="504" height="946" loading="lazy" />
            <img src="/images/our-light-unbound/homepage-mobile.png" alt="Our Light Unbound mobile catalogue homepage showing exhibition hero, search bar, and artist list" width="390" height="595" loading="lazy" />
          </div>
        </div>
      </section>

      <!-- 5. Programming the month -->
      <section class="case-section section" id="programming-month" aria-labelledby="programming-month-heading">
        <div class="container">
          <h2 id="programming-month-heading" class="case-section__heading reveal">Programming the month</h2>
          <p class="reveal">The exhibition continued beyond opening night through a month of programming.</p>
          <p class="reveal">The schedule included collage, paint-and-sip, an origami mobile workshop, a flexagon-zine workshop, an artist talk, and a closing event.</p>
          <p class="reveal">Programming became another way for visitors to interact with the ideas in the exhibition rather than treating the gallery as a single opening-night moment.</p>

          <div class="two-col reveal">
            <img src="/images/our-light-unbound/collage-workshop.png" alt="Participants seated at long tables in the brick-walled gallery cutting and pasting from magazines and printed materials during the collage workshop" width="1200" height="900" loading="lazy" class="photo" />
            <img src="/images/our-light-unbound/paint-and-sip.png" alt="Visitors painting during the paint-and-sip workshop at Slip Gallery" width="1200" height="1600" loading="lazy" class="photo" />
          </div>

          <img src="/images/our-light-unbound/origami-mobile-workshop-1.png" alt="Participants folding origami cranes at a long table near the gallery's street-facing windows with colorful paper and embroidery hoops for assembling hanging mobiles" width="1200" height="1600" class="reveal photo" loading="lazy" />
        </div>
      </section>

      <!-- 6. Designing for participation -->
      <section class="case-section section" id="designing-participation" aria-labelledby="designing-participation-heading">
        <div class="container">
          <h2 id="designing-participation-heading" class="case-section__heading reveal">Designing for participation</h2>
          <p class="reveal">Two participatory installations invited visitors to leave something behind.</p>
          <p class="reveal">A world map let people mark where they came from and add notes. A graffiti wall gave visitors another open-ended surface to respond on.</p>
          <p class="reveal">Both filled over the course of the exhibition.</p>

          <div class="two-col reveal">
            <img src="/images/our-light-unbound/interactive-map.png" alt="Close-up of the interactive world map covered in colorful sticky notes with handwritten visitor messages and pins marking visitors' home countries" width="1200" height="1600" loading="lazy" class="photo" />
            <img src="/images/our-light-unbound/interactive-installation.jpg" alt="Visitors engaging with interactive installations, gathering around pieces and discussing them" width="1600" height="1067" loading="lazy" class="photo" />
          </div>
        </div>
      </section>

      <!-- 7. Keeping the whole thing coherent -->
      <section class="case-section section" id="keeping-coherent" aria-labelledby="keeping-coherent-heading">
        <div class="container">
          <h2 id="keeping-coherent-heading" class="case-section__heading reveal">Keeping the whole thing coherent</h2>
          <p class="reveal">The exhibition ran publicly at Slip Gallery through January 2026 after roughly eighteen months of planning.</p>
          <p class="reveal">Opening night brought 1,000+ visitors. That figure refers specifically to opening night, not total attendance across the full month.</p>
          <p class="reveal">The project moved across grants, artist coordination, campaign design, programming, accessibility, physical gallery decisions, and a digital catalogue. The work was spread across many surfaces, but visitors still needed it to feel like one exhibition.</p>

          <img src="/images/our-light-unbound/visitors-examining-art.jpg" alt="Visitors examining paintings up close at the exhibition, pointing at and discussing the artwork on display" width="1600" height="2400" class="reveal photo" loading="lazy" />
        </div>
      </section>

    </div>
  </div>

  <KeepExploring
    next={{ name: 'Seattle AI on Tap Gallery Walk', headline: 'Designing an event where people could interact with AI-built projects.', href: '/ai-on-tap-gallery-walk/' }}
    alt={{ name: 'Bb Budget', headline: 'Building a household budgeting product for two people with distinct tracking habits.', href: '/bb-budget/' }}
  />
</BaseLayout>

<script is:inline src="/scripts/scroll-spy.js"></script>
